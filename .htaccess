# Disable directory browsing
Options -Indexes

# Deny access to sensitive files
<Files ~ "\.(tpl|sql|log)$">
    Order allow,deny
    Deny from all
</Files>

# Protect configuration files
<Files ~ "config\.php$">
    Order allow,deny
    Deny from all
</Files>

# Protect log files
<FilesMatch "\.(log|txt)$">
    Order allow,deny
    Deny from all
</FilesMatch>